{
  "name": "@nubisco/ui",
  "version": "4.1.4",
  "description": "Vue 3 UI component library",
  "packageManager": "pnpm@11.0.8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nubisco/ui.git"
  },
  "author": "José Silva <jose@nubisco.io>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nubisco/ui/issues"
  },
  "homepage": "https://docs.nubisco.io/ui/",
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "ui",
    "design-system",
    "typescript",
    "vite"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss",
    "**/icons/all.mjs",
    "**/flags/all.mjs"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "import": "./dist/all.mjs",
      "require": "./dist/all.cjs",
      "default": "./dist/all.mjs"
    },
    "./vite": {
      "types": "./dist/plugins/vite/index.d.ts",
      "import": "./dist/plugins/vite/index.js",
      "default": "./dist/plugins/vite/index.js"
    },
    "./dist/ui.css": "./dist/ui.css",
    "./dist/styles/*": "./dist/styles/*",
    "./component-styles.json": "./dist/component-styles.json",
    "./assets/nubisco-mark.svg": "./src/assets/nubisco-mark.svg",
    "./assets/nubisco-platform-mark.svg": "./src/assets/nubisco-platform-mark.svg",
    "./plugins/*": {
      "types": "./dist/plugins/*.d.ts",
      "import": "./dist/plugins/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.mjs",
      "require": "./dist/components/*.cjs",
      "default": "./dist/components/*.mjs"
    },
    "./icons/all": {
      "types": "./dist/icons/all.d.ts",
      "import": "./dist/icons/all.mjs",
      "default": "./dist/icons/all.mjs"
    },
    "./icons/catalog": {
      "types": "./dist/icons/catalog.d.ts",
      "import": "./dist/icons/catalog.mjs",
      "default": "./dist/icons/catalog.mjs"
    },
    "./icons/*": {
      "types": "./dist/icons/module.d.ts",
      "import": "./dist/icons/*.mjs",
      "default": "./dist/icons/*.mjs"
    },
    "./flags/all": {
      "types": "./dist/flags/all.d.ts",
      "import": "./dist/flags/all.mjs",
      "default": "./dist/flags/all.mjs"
    },
    "./flags/catalog": {
      "types": "./dist/flags/catalog.d.ts",
      "import": "./dist/flags/catalog.mjs",
      "default": "./dist/flags/catalog.mjs"
    },
    "./flags/*": {
      "types": "./dist/flags/module.d.ts",
      "import": "./dist/flags/*.mjs",
      "default": "./dist/flags/*.mjs"
    },
    "./composables/*": {
      "types": "./dist/composables/*.d.ts",
      "import": "./dist/composables/*.mjs",
      "require": "./dist/composables/*.cjs",
      "default": "./dist/composables/*.mjs"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.mjs",
      "require": "./dist/utils/*.cjs",
      "default": "./dist/utils/*.mjs"
    },
    "./styles": "./src/styles/index.scss",
    "./styles/*": "./src/styles/*",
    "./css": "./dist/ui.css",
    "./scss": "./src/styles/index.scss",
    "./variables": "./src/styles/variables/index.scss",
    "./global": {
      "types": "./dist/global.d.ts"
    }
  },
  "files": [
    "dist",
    "src/styles",
    "src/plugins",
    "src/utils",
    "src/assets/icons",
    "src/assets/nubisco-mark.svg",
    "src/assets/nubisco-platform-mark.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "pnpm run clean && pnpm run generate",
    "build": "pnpm run build:lib && pnpm run build:types && pnpm run build:plugins && node scripts/finalize-dist.mjs && pnpm run verify:types",
    "build:lib": "vite build",
    "build:types": "vue-tsc --noEmit false --declaration --emitDeclarationOnly --outDir dist && node scripts/copy-type-modules.mjs && node scripts/rewrite-dist-aliases.mjs dist",
    "build:plugins": "tsc --project tsconfig.plugins.json",
    "verify:types": "pnpm run verify:dist-types && pnpm run verify:consumer-types && pnpm run verify:consumer-globals && pnpm run verify:resolution && pnpm run verify:styles && pnpm run verify:glyph-defaults",
    "verify:dist-types": "node scripts/verify-dist-types.mjs dist",
    "verify:consumer-types": "node scripts/verify-consumer-types.mjs",
    "verify:consumer-globals": "node scripts/verify-consumer-globals.mjs",
    "dev": "vite build --watch",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run generate && vitest run",
    "test:coverage": "pnpm run generate && vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "types:check": "pnpm run generate && vue-tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality:check": "pnpm run test && pnpm run lint && pnpm run format:check && pnpm run types:check && pnpm run verify:marks",
    "docs:dev": "pnpm run generate && vitepress dev docs",
    "docs:build": "pnpm run generate && node scripts/build-tokens.mjs && vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "prepare": "simple-git-hooks",
    "verify:marks": "node scripts/verify-inlined-marks.mjs",
    "generate": "node scripts/generate-component-manifest.mjs && node scripts/generate-assets.mjs && node scripts/generate-entries.mjs",
    "verify:resolution": "node scripts/verify-compile-time-resolution.mjs dist",
    "verify:styles": "node scripts/verify-style-split.mjs dist",
    "verify:glyph-defaults": "node scripts/verify-default-glyphs.mjs dist"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && pnpm run quality:check",
    "pre-push": "pnpm run quality:check"
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": "prettier --write",
    "*.{json,md,mts,mjs,scss}": "prettier --write"
  },
  "peerDependencies": {
    "pixi.js": "^8.0.0",
    "unplugin-fonts": ">=1.4.0",
    "vue": "^3.5.30",
    "vue-i18n": "^11.3.0"
  },
  "peerDependenciesMeta": {
    "unplugin-fonts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@phosphor-icons/core": "^2.1.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.1",
    "@vitest/ui": "^4.1.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "markdown-it-container": "^4.0.0",
    "mermaid": "^11.13.0",
    "pixi.js": "^8.19.0",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.98.0",
    "semantic-release": "^25.0.3",
    "simple-git-hooks": "^2.13.1",
    "tinycolor2": "^1.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.2",
    "vite-svg-loader": "^5.1.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.7.1",
    "vitest": "^4.1.1",
    "vue": "^3.5.30",
    "vue-eslint-parser": "^10.4.0",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.2.6"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ]
    ]
  },
  "dependencies": {
    "magic-string": "^1.2.3",
    "unplugin-vue-components": "^32.1.0"
  }
}
